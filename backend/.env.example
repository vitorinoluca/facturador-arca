DATABASE_URL=postgresql://facturador:facturador_dev@localhost:5434/facturador_arca
JWT_SECRET=cambiar-este-secreto
AFIPSDK_ACCESS_TOKEN=obtener-gratis-en-https://afipsdk.com
FRONTEND_URL=http://localhost:3000
PORT=3001

# Mail (verificar email, recuperar contraseña) — gratis en https://resend.com.
# Sin esto configurado, los mails se loguean en la consola del backend en vez de
# mandarse de verdad (para poder seguir developando sin la cuenta creada todavía).
RESEND_API_KEY=
MAIL_FROM="Facturador ARCA <onboarding@resend.dev>"

# Iniciar sesión con Google — crear en https://console.cloud.google.com/apis/credentials
# (tipo "Web application"). El redirect URI autorizado ahí tiene que ser EXACTAMENTE
# este valor (con /auth/google/callback al final).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Certificados ÚNICOS de la app (no por usuario) — cada usuario delega la
# facturación electrónica en el CUIT de estos certificados desde ARCA (ver
# NEXT_PUBLIC_AFIP_APP_CUIT en el frontend). ARCA no confía el mismo certificado en
# testing y en producción, así que son dos pares distintos. Pegar el contenido del
# .crt y el .key con los saltos de línea como \n literal (una sola línea).
AFIP_APP_CERT_TESTING="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
AFIP_APP_KEY_TESTING="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
AFIP_APP_CERT_PRODUCTION="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
AFIP_APP_KEY_PRODUCTION="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# el CUIT dueño de ambos certificados (necesario para la consulta de padrón)
AFIP_APP_CUIT=tu-cuit-sin-guiones
