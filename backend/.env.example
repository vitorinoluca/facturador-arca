DATABASE_URL=postgresql://facturador:facturador_dev@localhost:5434/facturador_arca
JWT_SECRET=cambiar-este-secreto
AFIPSDK_ACCESS_TOKEN=obtener-gratis-en-https://afipsdk.com
FRONTEND_URL=http://localhost:3000
PORT=3001

# Certificado ÚNICO de la app (no por usuario) — cada usuario delega la facturación
# electrónica en el CUIT de este certificado desde ARCA (ver NEXT_PUBLIC_AFIP_APP_CUIT
# en el frontend). Pegar el contenido del .crt y el .key con los saltos de línea como
# \n literal (una sola línea).
AFIP_APP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
AFIP_APP_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# el CUIT dueño del certificado de arriba (necesario para la consulta de padrón)
AFIP_APP_CUIT=tu-cuit-sin-guiones
